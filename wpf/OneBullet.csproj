<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>1bullet</AssemblyName>
    <RootNamespace>OneBullet</RootNamespace>
    <ApplicationIcon>..\assets\1bullet.ico</ApplicationIcon>
    <!-- Single source of truth: the repo-root VERSION file. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\VERSION').Trim())</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Company>Saif</Company>
    <Product>1 Bullet</Product>
    <Description>1 Bullet — live VALORANT companion. Made by Saif.</Description>
  </PropertyGroup>

</Project>
