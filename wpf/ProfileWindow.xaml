<Window x:Class="OneBullet.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Player profile — 1 Bullet" Height="720" Width="900"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#0B0B0E">
    <Grid>
        <Image Source="{Binding BannerArt}" Stretch="UniformToFill"
               HorizontalAlignment="Right" Width="420" Opacity="0.22"
               Visibility="{Binding BannerArt, Converter={StaticResource NullToCollapsed}}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,18">
                <DockPanel>
                    <Grid Width="64" Height="64" Margin="0,0,14,0">
                        <Border Background="#18181C" CornerRadius="8"
                                BorderBrush="#18E5A7" BorderThickness="2" />
                        <Image Source="{Binding Portrait}" Stretch="UniformToFill" />
                    </Grid>
                    <Button Content="✕" DockPanel.Dock="Right" VerticalAlignment="Top"
                            Style="{StaticResource GhostButton}" Padding="10,4"
                            Click="Close_Click" />
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontSize="24" FontWeight="Black"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{Binding SubLine}" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{StaticResource DimBrush}"
                                   Visibility="{Binding SubLine, Converter={StaticResource StringEmptyToCollapsed}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasRankLine, Converter={StaticResource BoolToVisible}}">
                            <Image Source="{Binding RankIcon}" Width="18" Height="18" Margin="0,0,7,0"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{Binding RankLine}" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding HasPeakLine, Converter={StaticResource BoolToVisible}}">
                                <TextBlock Text="· Peak" FontSize="10" Foreground="{StaticResource DimBrush}"
                                           Margin="10,0,6,0" VerticalAlignment="Center" />
                                <Image Source="{Binding PeakIcon}" Width="16" Height="16" Margin="0,0,5,0"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding PeakLine}" FontSize="11"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{StaticResource DimBrush}"
                                   Visibility="{Binding Status, Converter={StaticResource StringEmptyToCollapsed}}" />
                    </StackPanel>
                </DockPanel>

                <TextBlock Text="RECENT FORM" FontSize="12" FontWeight="Bold"
                           Margin="0,18,0,8" Foreground="{StaticResource DimBrush}" />
                <ItemsControl ItemsSource="{Binding RecentForm}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="8" Background="#0D0D10" Padding="8" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="Black"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="{Binding Label}" FontSize="10"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource DimBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="SKINS INVENTORY" FontSize="12" FontWeight="Bold"
                           Margin="0,10,0,8" Foreground="{StaticResource DimBrush}" />
                <ItemsControl ItemsSource="{Binding Skins}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="8" Background="#0D0D10" Padding="8"
                                    Margin="0,0,8,8" Width="128">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="10"
                                               Foreground="{StaticResource DimBrush}" />
                                    <Image Source="{Binding Icon}" Height="40"
                                           Stretch="Uniform" Margin="0,6" />
                                    <TextBlock Text="{Binding Name}" FontSize="11"
                                               Foreground="{StaticResource TextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="PAST GAMES" FontSize="12" FontWeight="Bold"
                           Margin="0,10,0,8" Foreground="{StaticResource DimBrush}" />
                <ItemsControl ItemsSource="{Binding PastGames}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="8" Background="#0D0D10" Padding="10"
                                    Margin="0,0,0,8" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.OpenMatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <DockPanel>
                                    <Grid Width="40" Height="40" Margin="0,0,12,0">
                                        <Border Background="#18181C" CornerRadius="6" />
                                        <Image Source="{Binding AgentPortrait}" Stretch="UniformToFill" />
                                    </Grid>
                                    <TextBlock Text="›" DockPanel.Dock="Right" FontSize="20"
                                               VerticalAlignment="Center" Margin="10,0,4,0"
                                               Foreground="{StaticResource DimBrush}" />
                                    <StackPanel DockPanel.Dock="Right" Margin="0,0,4,0"
                                                VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Kda}" FontSize="14" FontWeight="Bold"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource DimBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ResultLetter}" DockPanel.Dock="Right"
                                               FontSize="14" FontWeight="Black" VerticalAlignment="Center"
                                               Margin="0,0,12,0"
                                               Foreground="{Binding ResultColor, Converter={StaticResource HexToBrush}}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Match.Map}" FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding Match.Mode}" FontSize="10" Margin="8,0,0,0"
                                                       VerticalAlignment="Bottom"
                                                       Foreground="{StaticResource DimBrush}" />
                                        </StackPanel>
                                        <TextBlock FontSize="11" Foreground="{StaticResource DimBrush}">
                                            <Run Text="{Binding Match.Agent, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Match.Score, Mode=OneWay}" /><Run Text="–" /><Run Text="{Binding Match.OpponentScore, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
