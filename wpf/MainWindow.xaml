<Window x:Class="OneBullet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="1 Bullet" Height="760" Width="1080"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Grid>
        <!-- Custom background + readability overlay -->
        <Image Source="{Binding BackgroundImage}" Stretch="UniformToFill"
               Visibility="{Binding HasBackground, Converter={StaticResource BoolToVisible}}" />
        <Rectangle Fill="Black" Opacity="0.68"
                   Visibility="{Binding HasBackground, Converter={StaticResource BoolToVisible}}" />

        <DockPanel Margin="20,14">
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top">
                <DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="1 BULLET" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Made by Saif" FontSize="12" Margin="10,0,0,0"
                                   VerticalAlignment="Bottom"
                                   Foreground="{StaticResource DimBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding VersionText}" FontSize="12"
                               DockPanel.Dock="Right" VerticalAlignment="Bottom"
                               Foreground="{StaticResource DimBrush}" />
                </DockPanel>
                <TextBlock Text="{Binding StateLabel}" FontSize="16" FontWeight="SemiBold"
                           Margin="0,6,0,0" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="{Binding ScoreLine}" FontSize="12"
                           Foreground="{StaticResource DimBrush}"
                           Visibility="{Binding ScoreLine, Converter={StaticResource StringEmptyToCollapsed}}" />

                <!-- Update banner -->
                <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,8" Margin="0,10,0,0"
                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisible}}">
                    <DockPanel>
                        <Button Content="Download Update" DockPanel.Dock="Right"
                                Command="{Binding DownloadUpdateCommand}" />
                        <TextBlock Text="{Binding UpdateText}" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                    </DockPanel>
                </Border>

                <!-- Notice banner -->
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,8" Margin="0,10,0,0" Background="#141F2A"
                        Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrush}" />
                </Border>
            </StackPanel>

            <!-- Status bar -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,10,0,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="Retry" Command="{Binding RetryBackendCommand}"
                                Style="{StaticResource GhostButton}"
                                Visibility="{Binding Backend.LogTail, Converter={StaticResource StringEmptyToCollapsed}}" />
                        <Button Content="Open Logs" Command="{Binding OpenLogsCommand}"
                                Style="{StaticResource GhostButton}" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource DimBrush}">
                        <Run Text="{Binding Backend.StatusText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding BackendVersion, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
            </Border>
            <Expander DockPanel.Dock="Bottom" Header="Error details" Margin="0,6,0,0"
                      Foreground="{StaticResource DimBrush}"
                      Visibility="{Binding Backend.LogTail, Converter={StaticResource StringEmptyToCollapsed}}">
                <ScrollViewer MaxHeight="140">
                    <TextBlock Text="{Binding Backend.LogTail}" FontFamily="Consolas"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource DimBrush}" />
                </ScrollViewer>
            </Expander>

            <!-- Body -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                <StackPanel>
                    <!-- Empty / waiting state -->
                    <StackPanel Visibility="{Binding HasPlayers, Converter={StaticResource InvertBoolToCollapsed}}">
                        <TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Foreground="{StaticResource DimBrush}" FontSize="14" Margin="0,30" />
                        <TextBlock Text="No fake players are shown."
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource DimBrush}" FontSize="12" />
                    </StackPanel>

                    <!-- Teams -->
                    <ItemsControl ItemsSource="{Binding Teams}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,16">
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Title}" FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{Binding Info}" DockPanel.Dock="Right"
                                                   VerticalAlignment="Bottom"
                                                   Foreground="{StaticResource DimBrush}" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Players}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource LineBrush}"
                                                        BorderThickness="1" CornerRadius="8"
                                                        Background="#141F2A" Padding="12" Margin="0,0,0,10"
                                                        MaxWidth="860" HorizontalAlignment="Stretch">
                                                    <StackPanel>
                                                        <!-- Player card banner -->
                                                        <Image Source="{Binding CardBanner}" Height="52"
                                                               Stretch="UniformToFill" Margin="-12,-12,-12,10"
                                                               Visibility="{Binding CardBanner, Converter={StaticResource NullToCollapsed}}" />
                                                        <DockPanel>
                                                            <!-- Agent portrait -->
                                                            <Grid Width="64" Height="64" Margin="0,0,12,0">
                                                                <Border Background="#1C2A36" CornerRadius="6" />
                                                                <Image Source="{Binding AgentPortrait}"
                                                                       Stretch="UniformToFill" />
                                                            </Grid>
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               FontWeight="Bold" FontSize="14"
                                                                               Foreground="{StaticResource TextBrush}" />
                                                                    <TextBlock Text="{Binding HiddenTag}"
                                                                               FontStyle="Italic" FontSize="12"
                                                                               Foreground="#FF4655" />
                                                                    <Border BorderBrush="{Binding PartyColor, Converter={StaticResource HexToBrush}}"
                                                                            BorderThickness="1" CornerRadius="4"
                                                                            Padding="6,1" Margin="8,0,0,0"
                                                                            Visibility="{Binding HasParty, Converter={StaticResource BoolToVisible}}">
                                                                        <TextBlock Text="{Binding PartyText}"
                                                                                   FontSize="11"
                                                                                   Foreground="{Binding PartyColor, Converter={StaticResource HexToBrush}}" />
                                                                    </Border>
                                                                    <TextBlock Text="SELF" FontSize="10" FontWeight="Bold"
                                                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource AccentBrush}"
                                                                               Visibility="{Binding Dto.IsSelf, Converter={StaticResource BoolToVisible}}" />
                                                                    <TextBlock Text="⚠ smurf risk" FontSize="11"
                                                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                                                               Foreground="#FFB454"
                                                                               Visibility="{Binding IsSmurf, Converter={StaticResource BoolToVisible}}" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding SubLine}" FontSize="12"
                                                                           Foreground="{Binding Dto.RankColor, Converter={StaticResource HexToBrush}}" />
                                                                <TextBlock FontSize="12"
                                                                           Foreground="{StaticResource DimBrush}">
                                                                    <Run Text="{Binding StatsLine}" /><Run Text="   " /><Run Text="{Binding PeakLine}" />
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding EncounterText}" FontSize="12"
                                                                           Foreground="{StaticResource DimBrush}"
                                                                           Visibility="{Binding EncounterText, Converter={StaticResource StringEmptyToCollapsed}}" />
                                                            </StackPanel>
                                                            <!-- Rank icon -->
                                                            <Image Source="{Binding RankIcon}" Width="44" Height="44"
                                                                   DockPanel.Dock="Right" Margin="12,0,0,0"
                                                                   Visibility="{Binding RankIcon, Converter={StaticResource NullToCollapsed}}" />
                                                        </DockPanel>
                                                        <!-- Vandal + Phantom -->
                                                        <Grid Margin="0,10,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition />
                                                                <ColumnDefinition />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" BorderBrush="{StaticResource LineBrush}"
                                                                    BorderThickness="1" CornerRadius="6"
                                                                    Background="#132029" Padding="8" Margin="0,0,5,0"
                                                                    DataContext="{Binding Vandal}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Title}" FontSize="11"
                                                                               FontWeight="Bold"
                                                                               Foreground="{DynamicResource AccentBrush}" />
                                                                    <Image Source="{Binding Icon}" Height="44"
                                                                           Stretch="Uniform" Margin="0,4" />
                                                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                                                               Foreground="{StaticResource TextBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Grid.Column="1" BorderBrush="{StaticResource LineBrush}"
                                                                    BorderThickness="1" CornerRadius="6"
                                                                    Background="#132029" Padding="8" Margin="5,0,0,0"
                                                                    DataContext="{Binding Phantom}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Title}" FontSize="11"
                                                                               FontWeight="Bold"
                                                                               Foreground="{DynamicResource AccentBrush}" />
                                                                    <Image Source="{Binding Icon}" Height="44"
                                                                           Stretch="Uniform" Margin="0,4" />
                                                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                                                               Foreground="{StaticResource TextBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Settings -->
                    <GroupBox Header="Settings" Margin="0,6,0,10"
                              Foreground="{DynamicResource AccentBrush}"
                              BorderBrush="{StaticResource LineBrush}">
                        <StackPanel Margin="6">
                            <TextBlock Text="Theme accent" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ItemsControl ItemsSource="{Binding AccentPresets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="30" Height="26" Padding="0" Margin="0,0,6,0"
                                                    Background="{Binding Converter={StaticResource HexToBrush}}"
                                                    Command="{Binding DataContext.PickAccentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Content="" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Text="{Binding AccentHex, UpdateSourceTrigger=PropertyChanged}"
                                         Width="80" MaxLength="7" />
                                <Button Content="Save theme" Command="{Binding SaveAccentCommand}" />
                                <Button Content="Reset theme" Command="{Binding ResetAccentCommand}"
                                        Style="{StaticResource GhostButton}" />
                            </StackPanel>
                            <TextBlock Text="Background" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Choose image…" Command="{Binding BrowseBackgroundCommand}" />
                                <Button Content="Remove background" Command="{Binding RemoveBackgroundCommand}"
                                        Style="{StaticResource GhostButton}" />
                                <TextBlock Text="PNG, JPG, JPEG or WEBP. Stays on this PC."
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource DimBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="StartupCheck" Content="Start 1 Bullet with Windows"
                                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                          Click="StartupCheck_Click" />
                                <Button Content="Check for updates" Command="{Binding CheckUpdatesCommand}"
                                        Style="{StaticResource GhostButton}" />
                                <Button Content="Quit 1 Bullet" Command="{Binding QuitCommand}"
                                        Style="{StaticResource GhostButton}" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
