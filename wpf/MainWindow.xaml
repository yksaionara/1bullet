<Window x:Class="OneBullet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="1 Bullet" Height="760" Width="1080"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Grid>
        <!-- Custom background + readability overlay -->
        <Image Source="{Binding BackgroundImage}" Stretch="UniformToFill"
               Visibility="{Binding HasBackground, Converter={StaticResource BoolToVisible}}" />
        <Rectangle Fill="Black" Opacity="0.68"
                   Visibility="{Binding HasBackground, Converter={StaticResource BoolToVisible}}" />

        <DockPanel Margin="20,14">
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top">
                <DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="1 BULLET" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Made by Saif" FontSize="12" Margin="10,0,0,0"
                                   VerticalAlignment="Bottom"
                                   Foreground="{StaticResource DimBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding VersionText}" FontSize="12"
                               DockPanel.Dock="Right" VerticalAlignment="Bottom"
                               Foreground="{StaticResource DimBrush}" />
                </DockPanel>
                <!-- Match strip -->
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14,10" Margin="0,10,0,0" Background="#0D1319">
                    <WrapPanel VerticalAlignment="Center">
                        <Border BorderBrush="{Binding MatchStateColor, Converter={StaticResource HexToBrush}}"
                                BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,12,4">
                            <TextBlock Text="{Binding MatchStateText}" FontSize="12" FontWeight="Bold"
                                       Foreground="{Binding MatchStateColor, Converter={StaticResource HexToBrush}}" />
                        </Border>
                        <TextBlock Text="{Binding MapName}" FontSize="22" FontWeight="Black"
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,12,4"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding MapName, Converter={StaticResource StringEmptyToCollapsed}}" />
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10,4" Margin="0,0,12,4" Background="#141F2A"
                                Visibility="{Binding ModeName, Converter={StaticResource StringEmptyToCollapsed}}">
                            <TextBlock Text="{Binding ModeName}" FontSize="11"
                                       Foreground="{StaticResource DimBrush}" />
                        </Border>
                        <TextBlock Text="{Binding ScoreText}" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,12,4"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding ScoreText, Converter={StaticResource StringEmptyToCollapsed}}" />
                        <Border BorderBrush="{Binding SideColor, Converter={StaticResource HexToBrush}}"
                                BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,12,4"
                                Visibility="{Binding SideText, Converter={StaticResource StringEmptyToCollapsed}}">
                            <TextBlock Text="{Binding SideText}" FontSize="11" FontWeight="Bold"
                                       Foreground="{Binding SideColor, Converter={StaticResource HexToBrush}}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center"
                                    Visibility="{Binding HasWinProb, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="WIN PROB" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{StaticResource DimBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding WinProb, StringFormat={}{0}%}" FontSize="13"
                                       FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="#18E5A7" Margin="0,0,8,0" />
                            <ProgressBar Value="{Binding WinProb, Mode=OneWay}" Maximum="100"
                                         Width="140" Height="8" VerticalAlignment="Center"
                                         Foreground="#FF4655" Background="#232D38" BorderThickness="0" />
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!-- Detected parties strip -->
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14,8" Margin="0,10,0,0" Background="#0D1319">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="DETECTED PARTIES" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource DimBrush}" Margin="0,0,12,0" />
                        <ItemsControl ItemsSource="{Binding PartyPills}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{Binding Color, Converter={StaticResource HexToBrush}}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Text}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                    </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Update banner -->
                <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,8" Margin="0,10,0,0"
                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisible}}">
                    <DockPanel>
                        <Button Content="Download Update" DockPanel.Dock="Right"
                                Command="{Binding DownloadUpdateCommand}" />
                        <TextBlock Text="{Binding UpdateText}" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                    </DockPanel>
                </Border>

                <!-- Notice banner -->
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,8" Margin="0,10,0,0" Background="#141F2A"
                        Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrush}" />
                </Border>
            </StackPanel>

            <!-- Status bar -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,10,0,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="Retry" Command="{Binding RetryBackendCommand}"
                                Style="{StaticResource GhostButton}"
                                Visibility="{Binding Backend.LogTail, Converter={StaticResource StringEmptyToCollapsed}}" />
                        <Button Content="Open Logs" Command="{Binding OpenLogsCommand}"
                                Style="{StaticResource GhostButton}" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource DimBrush}">
                        <Run Text="{Binding Backend.StatusText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding BackendVersion, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
            </Border>
            <Expander DockPanel.Dock="Bottom" Header="Error details" Margin="0,6,0,0"
                      Foreground="{StaticResource DimBrush}"
                      Visibility="{Binding Backend.LogTail, Converter={StaticResource StringEmptyToCollapsed}}">
                <ScrollViewer MaxHeight="140">
                    <TextBlock Text="{Binding Backend.LogTail}" FontFamily="Consolas"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource DimBrush}" />
                </ScrollViewer>
            </Expander>

            <!-- Body -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                <StackPanel>
                    <!-- Empty / waiting state -->
                    <StackPanel Visibility="{Binding HasPlayers, Converter={StaticResource InvertBoolToCollapsed}}">
                        <TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Foreground="{StaticResource DimBrush}" FontSize="14" Margin="0,30" />
                        <TextBlock Text="No fake players are shown."
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource DimBrush}" FontSize="12" />
                    </StackPanel>

                    <!-- Team panels -->
                    <ItemsControl ItemsSource="{Binding TeamPanels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="10" Background="#0D1319" Padding="14"
                                        Margin="0,0,0,14">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Rectangle Width="4" Height="22" RadiusX="2" RadiusY="2"
                                                           Fill="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Black"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding Count}" FontSize="14" Margin="10,0,0,0"
                                                           VerticalAlignment="Bottom"
                                                           Foreground="{StaticResource DimBrush}" />
                                            </StackPanel>
                                            <Border DockPanel.Dock="Right" BorderBrush="{StaticResource LineBrush}"
                                                    BorderThickness="1" CornerRadius="8" Padding="12,6"
                                                    Background="#141F2A" VerticalAlignment="Center"
                                                    Visibility="{Binding HasAverages, Converter={StaticResource BoolToVisible}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding AvgRankIcon}" Width="22" Height="22"
                                                           Margin="0,0,8,0" VerticalAlignment="Center"
                                                           Visibility="{Binding AvgRankIcon, Converter={StaticResource NullToCollapsed}}" />
                                                    <StackPanel Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding AvgRank}" FontSize="13" FontWeight="Bold"
                                                                   Foreground="{Binding AvgRankColor, Converter={StaticResource HexToBrush}}" />
                                                        <TextBlock Text="AVG RANK" FontSize="9"
                                                                   Foreground="{StaticResource DimBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding AvgKd}" FontSize="13" FontWeight="Bold"
                                                                   Foreground="{StaticResource TextBrush}" />
                                                        <TextBlock Text="AVG K/D" FontSize="9"
                                                                   Foreground="{StaticResource DimBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding AvgWr}" FontSize="13" FontWeight="Bold"
                                                                   Foreground="{StaticResource TextBrush}" />
                                                        <TextBlock Text="AVG WR" FontSize="9"
                                                                   Foreground="{StaticResource DimBrush}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Smurfs}" FontSize="13" FontWeight="Bold"
                                                                   Foreground="{Binding SmurfColor, Converter={StaticResource HexToBrush}}" />
                                                        <TextBlock Text="SMURFS" FontSize="9"
                                                                   Foreground="{StaticResource DimBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Players}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource LineBrush}"
                                                            BorderThickness="1" CornerRadius="10"
                                                            Background="#0D1319" Margin="0,0,0,10"
                                                            Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding OpenProfileCommand}" />
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="5" />
                                                                <ColumnDefinition />
                                                            </Grid.ColumnDefinitions>
                                                            <Rectangle Grid.Column="0" RadiusX="2" RadiusY="2"
                                                                       Margin="5,10,0,10"
                                                                       Fill="{Binding PartyColor, Converter={StaticResource HexToBrush}}"
                                                                       Visibility="{Binding HasParty, Converter={StaticResource BoolToVisible}}" />
                                                            <Grid Grid.Column="1">
                                                                <Border CornerRadius="0,9,9,0" ClipToBounds="True"
                                                                        HorizontalAlignment="Right" Width="360"
                                                                        Opacity="0.16">
                                                                    <Image Source="{Binding Splash}"
                                                                           Stretch="UniformToFill" />
                                                                </Border>
                                                                <StackPanel Margin="14,12">
                                                                    <DockPanel>
                                                                        <StackPanel Orientation="Horizontal"
                                                                                    DockPanel.Dock="Right"
                                                                                    VerticalAlignment="Center">
                                                                            <StackPanel Width="62">
                                                                                <TextBlock Text="{Binding KdText}"
                                                                                           FontSize="22" FontWeight="Black"
                                                                                           HorizontalAlignment="Center"
                                                                                           Foreground="{Binding KdValue, Converter={StaticResource KdToBrush}}" />
                                                                                <TextBlock Text="K/D" FontSize="10"
                                                                                           HorizontalAlignment="Center"
                                                                                           Foreground="{StaticResource DimBrush}" />
                                                                            </StackPanel>
                                                                            <StackPanel Width="62">
                                                                                <TextBlock Text="{Binding HsText}"
                                                                                           FontSize="22" FontWeight="Black"
                                                                                           HorizontalAlignment="Center"
                                                                                           Foreground="{StaticResource TextBrush}" />
                                                                                <TextBlock Text="HS%" FontSize="10"
                                                                                           HorizontalAlignment="Center"
                                                                                           Foreground="{StaticResource DimBrush}" />
                                                                            </StackPanel>
                                                                            <StackPanel Width="62">
                                                                                <TextBlock Text="{Binding WinText}"
                                                                                           FontSize="22" FontWeight="Black"
                                                                                           HorizontalAlignment="Center"
                                                                                           Foreground="{StaticResource TextBrush}" />
                                                                                <TextBlock Text="WIN" FontSize="10"
                                                                                           HorizontalAlignment="Center"
                                                                                           Foreground="{StaticResource DimBrush}" />
                                                                            </StackPanel>
                                                                            <StackPanel Width="62">
                                                                                <TextBlock Text="{Binding LvlText}"
                                                                                           FontSize="22" FontWeight="Black"
                                                                                           HorizontalAlignment="Center"
                                                                                           Foreground="{StaticResource TextBrush}" />
                                                                                <TextBlock Text="LVL" FontSize="10"
                                                                                           HorizontalAlignment="Center"
                                                                                           Foreground="{StaticResource DimBrush}" />
                                                                            </StackPanel>
                                                                            <StackPanel Margin="14,0,0,0"
                                                                                        VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding AgentUpper}"
                                                                                           FontSize="13" FontWeight="Bold"
                                                                                           HorizontalAlignment="Right"
                                                                                           Foreground="{StaticResource TextBrush}" />
                                                                                <TextBlock Text="{Binding RoleUpper}"
                                                                                           FontSize="10"
                                                                                           HorizontalAlignment="Right"
                                                                                           Foreground="{StaticResource DimBrush}" />
                                                                            </StackPanel>
                                                                            <Grid Width="56" Height="56" Margin="10,0,0,0">
                                                                                <Border Background="#1C2A36" CornerRadius="8" />
                                                                                <Image Source="{Binding AgentPortrait}"
                                                                                       Stretch="UniformToFill" />
                                                                            </Grid>
                                                                        </StackPanel>
                                                                        <StackPanel>
                                                                            <StackPanel Orientation="Horizontal"
                                                                                        VerticalAlignment="Center">
                                                                                <Border Background="{Binding PartyColor, Converter={StaticResource HexToBrush}}"
                                                                                        CornerRadius="4" Padding="7,2"
                                                                                        Margin="0,0,8,0" VerticalAlignment="Center"
                                                                                        Visibility="{Binding HasParty, Converter={StaticResource BoolToVisible}}">
                                                                                    <TextBlock Text="{Binding Dto.Party.Number}"
                                                                                               FontSize="12" FontWeight="Bold"
                                                                                               Foreground="White" />
                                                                                </Border>
                                                                                <TextBlock Text="{Binding DisplayName}"
                                                                                           FontSize="19" FontWeight="Black"
                                                                                           Foreground="{StaticResource TextBrush}" />
                                                                                <TextBlock Text="{Binding HiddenTag}"
                                                                                           FontStyle="Italic" FontSize="12"
                                                                                           VerticalAlignment="Center"
                                                                                           Foreground="#FF4655" />
                                                                                <Border Background="{DynamicResource AccentBrush}"
                                                                                        CornerRadius="4" Padding="7,2"
                                                                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                                                                        Visibility="{Binding Dto.IsSelf, Converter={StaticResource BoolToVisible}}">
                                                                                    <TextBlock Text="YOU" FontSize="10"
                                                                                               FontWeight="Bold"
                                                                                               Foreground="White" />
                                                                                </Border>
                                                                                <Border BorderBrush="#FF4655" BorderThickness="1"
                                                                                        CornerRadius="4" Padding="7,2"
                                                                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                                                                        Visibility="{Binding IsSmurf, Converter={StaticResource BoolToVisible}}">
                                                                                    <TextBlock Text="⚠ SMURF" FontSize="11"
                                                                                               FontWeight="Bold"
                                                                                               Foreground="#FF4655" />
                                                                                </Border>
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding TitleLine}"
                                                                                       FontStyle="Italic" FontSize="12"
                                                                                       Foreground="{StaticResource DimBrush}"
                                                                                       Visibility="{Binding TitleLine, Converter={StaticResource StringEmptyToCollapsed}}" />
                                                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                                <Image Source="{Binding RankIcon}"
                                                                                       Width="20" Height="20" Margin="0,0,8,0"
                                                                                       Visibility="{Binding RankIcon, Converter={StaticResource NullToCollapsed}}" />
                                                                                <TextBlock Text="{Binding RankName}"
                                                                                           FontSize="13" FontWeight="Bold"
                                                                                           Foreground="{StaticResource TextBrush}" />
                                                                                <TextBlock Text="{Binding RrText}"
                                                                                           FontSize="13" FontWeight="Bold"
                                                                                           Margin="8,0,0,0"
                                                                                           Foreground="#FF4655" />
                                                                                <TextBlock Text="{Binding RrDeltaText}"
                                                                                           FontSize="12" Margin="4,0,0,0"
                                                                                           VerticalAlignment="Bottom"
                                                                                           Foreground="{Binding RrDeltaColor, Converter={StaticResource HexToBrush}}"
                                                                                           Visibility="{Binding RrDeltaText, Converter={StaticResource StringEmptyToCollapsed}}" />
                                                                                <TextBlock Text="|  PEAK" FontSize="12"
                                                                                           Margin="12,0,0,0"
                                                                                           Foreground="{StaticResource DimBrush}" />
                                                                                <Image Source="{Binding PeakIcon}"
                                                                                       Width="18" Height="18" Margin="6,0,6,0"
                                                                                       Visibility="{Binding PeakIcon, Converter={StaticResource NullToCollapsed}}" />
                                                                                <TextBlock Text="{Binding PeakRankName}"
                                                                                           FontSize="13" FontWeight="Bold"
                                                                                           Foreground="{Binding Dto.PeakColor, Converter={StaticResource HexToBrush}}" />
                                                                                <TextBlock Text="{Binding Dto.PeakAct}"
                                                                                           FontSize="12" Margin="6,0,0,0"
                                                                                           Foreground="{StaticResource DimBrush}" />
                                                                                <TextBlock Text="{Binding EncounterText}"
                                                                                           FontSize="12" Margin="12,0,0,0"
                                                                                           Foreground="{StaticResource DimBrush}"
                                                                                           Visibility="{Binding EncounterText, Converter={StaticResource StringEmptyToCollapsed}}" />
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                    <Grid Margin="0,10,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition />
                                                                            <ColumnDefinition />
                                                                            <ColumnDefinition />
                                                                            <ColumnDefinition />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0" BorderBrush="{StaticResource LineBrush}"
                                                                                BorderThickness="1" CornerRadius="6"
                                                                                Background="#132029" Padding="8" Margin="0,0,5,0"
                                                                                DataContext="{Binding Vandal}">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Title}" FontSize="11"
                                                                                           FontWeight="Bold"
                                                                                           Foreground="{DynamicResource AccentBrush}" />
                                                                                <Image Source="{Binding Icon}" Height="40"
                                                                                       Stretch="Uniform" Margin="0,4" />
                                                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                                                           Foreground="{StaticResource TextBrush}"
                                                                                           TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <Border Grid.Column="1" BorderBrush="{StaticResource LineBrush}"
                                                                                BorderThickness="1" CornerRadius="6"
                                                                                Background="#132029" Padding="8" Margin="5,0,5,0"
                                                                                DataContext="{Binding Phantom}">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Title}" FontSize="11"
                                                                                           FontWeight="Bold"
                                                                                           Foreground="{DynamicResource AccentBrush}" />
                                                                                <Image Source="{Binding Icon}" Height="40"
                                                                                       Stretch="Uniform" Margin="0,4" />
                                                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                                                           Foreground="{StaticResource TextBrush}"
                                                                                           TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <Border Grid.Column="2" BorderBrush="{StaticResource LineBrush}"
                                                                                BorderThickness="1" CornerRadius="6"
                                                                                Background="#132029" Padding="8" Margin="5,0,5,0"
                                                                                DataContext="{Binding OperatorSkin}">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Title}" FontSize="11"
                                                                                           FontWeight="Bold"
                                                                                           Foreground="{DynamicResource AccentBrush}" />
                                                                                <Image Source="{Binding Icon}" Height="40"
                                                                                       Stretch="Uniform" Margin="0,4" />
                                                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                                                           Foreground="{StaticResource TextBrush}"
                                                                                           TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <Border Grid.Column="3" BorderBrush="{StaticResource LineBrush}"
                                                                                BorderThickness="1" CornerRadius="6"
                                                                                Background="#132029" Padding="8" Margin="5,0,0,0"
                                                                                DataContext="{Binding SheriffSkin}">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Title}" FontSize="11"
                                                                                           FontWeight="Bold"
                                                                                           Foreground="{DynamicResource AccentBrush}" />
                                                                                <Image Source="{Binding Icon}" Height="40"
                                                                                       Stretch="Uniform" Margin="0,4" />
                                                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                                                           Foreground="{StaticResource TextBrush}"
                                                                                           TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Settings -->
                    <GroupBox Header="Settings" Margin="0,6,0,10"
                              Foreground="{DynamicResource AccentBrush}"
                              BorderBrush="{StaticResource LineBrush}">
                        <StackPanel Margin="6">
                            <TextBlock Text="Theme accent" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ItemsControl ItemsSource="{Binding AccentPresets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="30" Height="26" Padding="0" Margin="0,0,6,0"
                                                    Background="{Binding Converter={StaticResource HexToBrush}}"
                                                    Command="{Binding DataContext.PickAccentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Content="" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Text="{Binding AccentHex, UpdateSourceTrigger=PropertyChanged}"
                                         Width="80" MaxLength="7" />
                                <Button Content="Save theme" Command="{Binding SaveAccentCommand}" />
                                <Button Content="Reset theme" Command="{Binding ResetAccentCommand}"
                                        Style="{StaticResource GhostButton}" />
                            </StackPanel>
                            <TextBlock Text="Background" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Choose image…" Command="{Binding BrowseBackgroundCommand}" />
                                <Button Content="Remove background" Command="{Binding RemoveBackgroundCommand}"
                                        Style="{StaticResource GhostButton}" />
                                <TextBlock Text="PNG, JPG, JPEG or WEBP. Stays on this PC."
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource DimBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="StartupCheck" Content="Start 1 Bullet with Windows"
                                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                          Click="StartupCheck_Click" />
                                <Button Content="Check for updates" Command="{Binding CheckUpdatesCommand}"
                                        Style="{StaticResource GhostButton}" />
                                <Button Content="Quit 1 Bullet" Command="{Binding QuitCommand}"
                                        Style="{StaticResource GhostButton}" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
