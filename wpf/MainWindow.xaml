<Window x:Class="OneBullet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="1 Bullet" Height="860" Width="1280"
        MinWidth="1020" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="LowQuality"
        TextOptions.TextFormattingMode="Display">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ClosePanelCommand}" />
    </Window.InputBindings>
    <Grid Background="#050506" TextElement.Foreground="{StaticResource TextPrimaryBrush}">
        <Image Source="{Binding BackgroundImage}" Stretch="UniformToFill"
               Opacity="0.18"
               Visibility="{Binding HasBackground, Converter={StaticResource BoolToVisible}}" />
        <Rectangle Fill="#D9050506"
                   Visibility="{Binding HasBackground, Converter={StaticResource BoolToVisible}}" />

        <Grid IsEnabled="{Binding IsDashboardEnabled}">
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: brand + primary match actions + utilities -->
            <Border Grid.Row="0" Margin="28,12,28,0" Height="56"
                    Background="#080809" BorderBrush="#242429" BorderThickness="1"
                    CornerRadius="12">
                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="V" Foreground="{DynamicResource AccentBrush}"
                                   FontFamily="Bahnschrift SemiBold" FontWeight="Black"
                                   FontSize="24" Margin="0,-3,9,0" />
                        <TextBlock Text="1 BULLET" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Bahnschrift SemiBold" FontWeight="Bold"
                                   FontSize="20" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                MinHeight="34" Padding="14,7" Command="{Binding DodgeCommand}"
                                AutomationProperties.Name="Dodge agent select"
                                ToolTip="Leave the current Agent Select.">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Dodge" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button MinHeight="34" Padding="16,7" Command="{Binding ShowPanelCommand}" CommandParameter="Instalock"
                                AutomationProperties.Name="Instalock"
                                ToolTip="Configure automatic agent locking.">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding InstalockButtonText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChromeButton}" Margin="8,0,0,0"
                                MinHeight="34" Padding="14,7"
                                Command="{Binding ShowPanelCommand}" CommandParameter="Offline"
                                AutomationProperties.Name="Riot presence"
                                ToolTip="Control how you appear to Riot friends.">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OfflineButtonText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource UtilityButton}" Margin="8,0,0,0"
                                MinHeight="34" Padding="14,7"
                                Command="{Binding ShowPanelCommand}" CommandParameter="Notifications"
                                AutomationProperties.Name="Game status"
                                ToolTip="View current VALORANT connection state.">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Game Status" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource UtilityButton}" Margin="8,0,0,0"
                                MinHeight="34" Padding="14,7"
                                Command="{Binding ShowPanelCommand}" CommandParameter="Settings"
                                AutomationProperties.Name="App settings"
                                ToolTip="Appearance, application, and advanced settings.">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Settings" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,8,28,12">
                    <!-- 1. Matchmaking / queue -->
                    <Border Background="#0A0A0D" BorderBrush="#242429" BorderThickness="1"
                            CornerRadius="12" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Matchmaking" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <Grid Grid.Row="1" Margin="0,10,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ItemsControl ItemsSource="{Binding QueueOptions}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Name}" Style="{StaticResource QueueButton}"
                                                    IsEnabled="{Binding IsEligible}" Margin="0,0,3,3"
                                                    ToolTip="This mode is not currently available for your party."
                                                    ToolTipService.ShowOnDisabled="True"
                                                    Command="{Binding DataContext.SelectQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Grid.Column="1" Content="{Binding QueueActionText}" MinWidth="140"
                                        Margin="16,0,0,0" Padding="18,10"
                                        IsEnabled="{Binding CanControlQueue}"
                                        ToolTip="{Binding QueueHint}" ToolTipService.ShowOnDisabled="True"
                                        Command="{Binding QueueActionCommand}" />
                            </Grid>
                            <TextBlock Grid.Row="2" Text="{Binding QueueHint}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <!-- 2. Live match status -->
                    <Border Margin="0,10,0,0" Background="#09090B"
                            BorderBrush="#242429" BorderThickness="1" CornerRadius="12" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border VerticalAlignment="Center"
                                        BorderBrush="{Binding ClientBadgeColor, Converter={StaticResource HexToBrush}}" BorderThickness="1"
                                        CornerRadius="6" Padding="9,5" Margin="0,0,8,0"
                                        ToolTip="VALORANT game connection.">
                                    <TextBlock Text="{Binding ClientBadgeText}" FontSize="10" FontWeight="Bold"
                                               Foreground="{Binding ClientBadgeColor, Converter={StaticResource HexToBrush}}" />
                                </Border>
                                <Border VerticalAlignment="Center" Background="#151519"
                                        BorderBrush="#2A2A30" BorderThickness="1"
                                        CornerRadius="6" Padding="9,5"
                                        Visibility="{Binding HasMatchContext, Converter={StaticResource InvertBoolToCollapsed}}"
                                        ToolTip="Lobby and queue state.">
                                    <TextBlock Text="{Binding QueueStatusText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <WrapPanel ClipToBounds="True"
                                           Visibility="{Binding HasMatchContext, Converter={StaticResource BoolToVisible}}">
                                    <TextBlock Text="{Binding MatchStateText}" Foreground="{Binding MatchStateColor, Converter={StaticResource HexToBrush}}"
                                               FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding MapName}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding ModeName}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding ScoreText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding SideText}" Foreground="{Binding SideColor, Converter={StaticResource HexToBrush}}"
                                               FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding HasWinProb, Converter={StaticResource BoolToVisible}}">
                                        <TextBlock Text="Win" FontSize="8" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding WinProb, StringFormat={}{0}%}" FontSize="10" FontWeight="Bold"
                                                   Foreground="#36D399" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ProgressBar Value="{Binding WinProb}" Maximum="100" Width="60" Height="5"
                                                     Foreground="{DynamicResource AccentBrush}" Background="#24242A" BorderThickness="0" />
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Text="{Binding LastUpdatedText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                           Visibility="{Binding HasMatchContext, Converter={StaticResource InvertBoolToCollapsed}}" />
                                <TextBlock Text="{Binding MatchActionMessage}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="{Binding HasMatchActionMessage, Converter={StaticResource BoolToVisible}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" Padding="11,7" Margin="0,0,8,0"
                                        Command="{Binding ShowTeamSideCommand}"
                                        IsEnabled="{Binding HasMatchContext}"
                                        ToolTip="Available during Agent Select and live matches."
                                        ToolTipService.ShowOnDisabled="True">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" />
                                        <TextBlock Text="Team Side" />
                                    </StackPanel>
                                </Button>
                                <Button Content="{Binding AutoRefreshText}" Style="{StaticResource UtilityButton}"
                                        Padding="9,6" Margin="0,0,8,0" FontSize="11"
                                        Command="{Binding ToggleAutoRefreshCommand}"
                                        ToolTip="Live refresh every 5 seconds. Click to pause or resume." />
                                <Button Style="{StaticResource UtilityButton}" Width="37" Height="34" Padding="0"
                                        Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh now"
                                        ToolTip="Refresh all data now.">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Backend failure: compact alert, diagnostics stay in Settings -->
                    <Border Margin="0,10,0,0" BorderBrush="#5A232B" BorderThickness="1"
                            Background="#160D10" CornerRadius="8" Padding="12,9"
                            Visibility="{Binding HasBackendFailure, Converter={StaticResource BoolToVisible}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Retry" Padding="12,6" Margin="0,0,8,0"
                                        Command="{Binding RetryBackendCommand}" />
                                <Button Content="Diagnostics" Style="{StaticResource SecondaryButton}" Padding="12,6"
                                        Command="{Binding ShowPanelCommand}" CommandParameter="Settings" />
                            </StackPanel>
                            <TextBlock Text="1 Bullet couldn't connect to its local service."
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Update notice -->
                    <Border Margin="0,10,0,0" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                            Background="#180B0E" CornerRadius="7" Padding="12,8"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisible}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Download" Padding="12,6"
                                    Command="{Binding DownloadUpdateCommand}" />
                            <TextBlock Text="{Binding UpdateText}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border Margin="0,10,0,0" BorderBrush="#493136" BorderThickness="1"
                            Background="#160D10" CornerRadius="7" Padding="12,8"
                            Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="{Binding NoticeText}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </Border>

                    <!-- 3. Parties + live players -->
                    <Border Margin="0,10,0,0" Background="#0A0A0D"
                            BorderBrush="#2A2A30" BorderThickness="1" CornerRadius="8" Padding="12,8"
                            Visibility="{Binding HasParties, Converter={StaticResource BoolToVisible}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Parties" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ItemsControl ItemsSource="{Binding PartyPills}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#381015" BorderBrush="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                BorderThickness="1" CornerRadius="5" Padding="9,3" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Text}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,10,0,0">
                        <StackPanel Visibility="{Binding HasPlayers, Converter={StaticResource InvertBoolToCollapsed}}">
                            <Border Background="#0A0A0D" BorderBrush="#242429"
                                    BorderThickness="1" CornerRadius="12" Padding="20">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="No live match data yet" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                                               FontWeight="SemiBold" TextAlignment="Center" />
                                    <TextBlock Text="{Binding EmptyMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding TeamPanels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0A0A0D" BorderBrush="#242429" BorderThickness="1"
                                            CornerRadius="12" Margin="0,0,0,10" ClipToBounds="True">
                                        <StackPanel>
                                            <Grid Height="56" Margin="14,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Rectangle Width="5" Height="22" RadiusX="2.5" RadiusY="2.5"
                                                               Fill="{DynamicResource AccentBrush}" Margin="0,0,10,0">
                                                        <Rectangle.Effect>
                                                            <DropShadowEffect Color="#FF4655" BlurRadius="13" ShadowDepth="0" Opacity="0.8" />
                                                        </Rectangle.Effect>
                                                    </Rectangle>
                                                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="12,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Background="#09090B" BorderBrush="#202025" BorderThickness="1"
                                                        CornerRadius="9" Padding="11,7"
                                                        Visibility="{Binding HasAverages, Converter={StaticResource BoolToVisible}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{Binding AvgRankIcon}" Width="20" Height="20" Margin="0,0,8,0" />
                                                        <StackPanel Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding AvgRank}" FontSize="12" FontWeight="Bold"
                                                                       Foreground="{Binding AvgRankColor, Converter={StaticResource HexToBrush}}" />
                                                            <TextBlock Text="Avg rank" FontSize="8" Foreground="{StaticResource TextMutedBrush}" />
                                                        </StackPanel>
                                                        <Border Width="1" Background="#25252A" Margin="0,0,12,0" />
                                                        <StackPanel Width="48">
                                                            <TextBlock Text="{Binding AvgKd}" HorizontalAlignment="Center" FontWeight="Bold" />
                                                            <TextBlock Text="Avg K/D" HorizontalAlignment="Center" FontSize="8" Foreground="{StaticResource TextMutedBrush}" />
                                                        </StackPanel>
                                                        <StackPanel Width="48">
                                                            <TextBlock Text="{Binding AvgWr}" HorizontalAlignment="Center" FontWeight="Bold" />
                                                            <TextBlock Text="Avg win" HorizontalAlignment="Center" FontSize="8" Foreground="{StaticResource TextMutedBrush}" />
                                                        </StackPanel>
                                                        <StackPanel Width="48">
                                                            <TextBlock Text="{Binding Smurfs}" HorizontalAlignment="Center" FontWeight="Bold"
                                                                       Foreground="{Binding SmurfColor, Converter={StaticResource HexToBrush}}" />
                                                            <TextBlock Text="Suspected" HorizontalAlignment="Center" FontSize="8" Foreground="{StaticResource TextMutedBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <Border Height="1" Background="#1D1D21" />
                                            <ItemsControl ItemsSource="{Binding Players}" Margin="8,8,8,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#0D0D10" BorderBrush="#242429" BorderThickness="1"
                                                                CornerRadius="10" Margin="0,0,0,8" Padding="10,8" Cursor="Hand">
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenProfileCommand}" />
                                                            </Border.InputBindings>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="4" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Rectangle Grid.Column="0" Fill="{Binding PartyColor, Converter={StaticResource HexToBrush}}"
                                                                           RadiusX="2" RadiusY="2"
                                                                           Visibility="{Binding HasParty, Converter={StaticResource BoolToVisible}}" />
                                                                <Grid Grid.Column="1" Width="46" Height="46" Margin="10,0,0,0"
                                                                      VerticalAlignment="Center" ToolTip="{Binding Dto.Agent}">
                                                                    <Border Background="#18181C" CornerRadius="8" />
                                                                    <Image Source="{Binding AgentPortrait}" Stretch="UniformToFill"
                                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                                        <Image.Clip>
                                                                            <RectangleGeometry Rect="0,0,46,46" RadiusX="8" RadiusY="8" />
                                                                        </Image.Clip>
                                                                    </Image>
                                                                </Grid>
                                                                <StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center">
                                                                    <DockPanel>
                                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <Border Background="#4A151B" CornerRadius="5" Padding="7,2" Margin="8,0,0,0"
                                                                                    Visibility="{Binding Dto.IsSelf, Converter={StaticResource BoolToVisible}}">
                                                                                <TextBlock Text="YOU" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                                            </Border>
                                                                            <Border Background="#250B0E" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                                                                    CornerRadius="5" Padding="7,2" Margin="8,0,0,0"
                                                                                    Visibility="{Binding IsSmurf, Converter={StaticResource BoolToVisible}}"
                                                                                    ToolTip="Flagged by smurf-detection heuristics.">
                                                                                <TextBlock Text="SUSPECT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <Border Background="{Binding PartyColor, Converter={StaticResource HexToBrush}}"
                                                                                    CornerRadius="5" Padding="7,2" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                                    Visibility="{Binding HasParty, Converter={StaticResource BoolToVisible}}">
                                                                                <TextBlock Text="{Binding Dto.Party.Number}" FontSize="10" FontWeight="Bold" />
                                                                            </Border>
                                                                             <TextBlock Text="{Binding DisplayName}" FontFamily="Bahnschrift SemiBold"
                                                                                        FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                                                                        TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                         </StackPanel>
                                                                    </DockPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0" VerticalAlignment="Center">
                                                                        <Image Source="{Binding RankIcon}" Width="18" Height="18" Margin="0,0,7,0"
                                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                                        <TextBlock Text="{Binding RankName}" FontSize="13" FontWeight="Bold"
                                                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding RrText}" FontSize="12" FontWeight="Bold"
                                                                                   Foreground="{DynamicResource AccentBrush}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="· Peak" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                                                                   Margin="12,0,6,0" VerticalAlignment="Center" />
                                                                        <Image Source="{Binding PeakIcon}" Width="16" Height="16" Margin="0,0,5,0"
                                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                                        <TextBlock Text="{Binding PeakRankName}" FontSize="11" VerticalAlignment="Center"
                                                                                   Foreground="{Binding Dto.PeakColor, Converter={StaticResource HexToBrush}}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <Grid Grid.Column="3" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="56" />
                                                                        <ColumnDefinition Width="56" />
                                                                        <ColumnDefinition Width="56" />
                                                                        <ColumnDefinition Width="56" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding KdText}" HorizontalAlignment="Center" FontSize="15" FontWeight="Bold"
                                                                                   Foreground="{Binding KdValue, Converter={StaticResource KdToBrush}}" />
                                                                        <TextBlock Text="K/D" HorizontalAlignment="Center" FontSize="8" Foreground="{StaticResource TextMutedBrush}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding HsText}" HorizontalAlignment="Center" FontSize="15" FontWeight="Bold"
                                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                                        <TextBlock Text="HS%" HorizontalAlignment="Center" FontSize="8" Foreground="{StaticResource TextMutedBrush}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding WinText}" HorizontalAlignment="Center" FontSize="15" FontWeight="Bold"
                                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                                        <TextBlock Text="Win" HorizontalAlignment="Center" FontSize="8" Foreground="{StaticResource TextMutedBrush}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding LvlText}" HorizontalAlignment="Center" FontSize="15" FontWeight="Bold"
                                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                                        <TextBlock Text="Level" HorizontalAlignment="Center" FontSize="8" Foreground="{StaticResource TextMutedBrush}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                                    <StackPanel Width="124">
                                                                        <TextBlock Text="Vandal" FontSize="9" FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource TextMutedBrush}" />
                                                                        <Image Source="{Binding Vandal.Icon}" Height="26" Stretch="Uniform" Margin="0,3"
                                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                                        <TextBlock Text="{Binding Vandal.Name}" FontSize="11"
                                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                    <StackPanel Width="124" Margin="10,0,0,0">
                                                                        <TextBlock Text="Phantom" FontSize="9" FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource TextMutedBrush}" />
                                                                        <Image Source="{Binding Phantom.Icon}" Height="26" Stretch="Uniform" Margin="0,3"
                                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                                        <TextBlock Text="{Binding Phantom.Name}" FontSize="11"
                                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <Button Grid.Column="5" Style="{StaticResource ChromeButton}" Padding="0" Width="36" Height="38"
                                                                        Margin="10,0,0,0" VerticalAlignment="Center"
                                                                        Command="{Binding OpenProfileCommand}"
                                                                        ToolTip="View profile">
                                                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="17" />
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 4. Performance -->
                    <Border Margin="0,0,0,8" Background="#09090B"
                            BorderBrush="#242429" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="4" Height="20" RadiusX="2" Fill="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                                        <TextBlock Text="Performance" FontSize="16" FontWeight="Bold" />
                                        <Border Background="#151519" CornerRadius="5" Padding="8,3" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding PerformanceAccount}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Rank progress, match reports, and sessions"
                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#08080A"
                                        BorderBrush="#202025" BorderThickness="1" CornerRadius="10" Padding="3">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Overview" MinWidth="88" Command="{Binding SelectPerformanceTabCommand}" CommandParameter="Overview">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FilterButton}"><Style.Triggers><DataTrigger Binding="{Binding PerformanceTab}" Value="Overview"><Setter Property="Background" Value="#29292E" /><Setter Property="Foreground" Value="#F1F1F3" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                        <Button Content="Matches" MinWidth="88" Command="{Binding SelectPerformanceTabCommand}" CommandParameter="Matches">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FilterButton}"><Style.Triggers><DataTrigger Binding="{Binding PerformanceTab}" Value="Matches"><Setter Property="Background" Value="#29292E" /><Setter Property="Foreground" Value="#F1F1F3" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                        <Button Content="Sessions" MinWidth="88" Command="{Binding SelectPerformanceTabCommand}" CommandParameter="Sessions">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FilterButton}"><Style.Triggers><DataTrigger Binding="{Binding PerformanceTab}" Value="Sessions"><Setter Property="Background" Value="#29292E" /><Setter Property="Foreground" Value="#F1F1F3" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Height="1" Background="#1E1E23" Margin="0,12,0,12" />

                            <!-- Overview: compact empty state until history exists -->
                            <StackPanel Visibility="{Binding IsOverviewTab, Converter={StaticResource BoolToVisible}}">
                            <Border BorderBrush="#27272D" BorderThickness="1" CornerRadius="10" Background="#08080A"
                                    Padding="18" Visibility="{Binding HasPerformance, Converter={StaticResource InvertBoolToCollapsed}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="No competitive history yet" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Play a competitive match to begin tracking rank progress."
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0"
                                               TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Grid Visibility="{Binding HasPerformance, Converter={StaticResource BoolToVisible}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="290" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="{Binding MatchCountText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Matches" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <Button Content="10" Command="{Binding SetMatchLimitCommand}" CommandParameter="10">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FilterButton}"><Style.Triggers><DataTrigger Binding="{Binding MatchLimit}" Value="10"><Setter Property="Background" Value="#29292E" /><Setter Property="Foreground" Value="#F1F1F3" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                            </Button>
                                            <Button Content="20" Command="{Binding SetMatchLimitCommand}" CommandParameter="20">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FilterButton}"><Style.Triggers><DataTrigger Binding="{Binding MatchLimit}" Value="20"><Setter Property="Background" Value="#29292E" /><Setter Property="Foreground" Value="#F1F1F3" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                            </Button>
                                            <Button Content="40" Command="{Binding SetMatchLimitCommand}" CommandParameter="40" Margin="0,0,4,0">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FilterButton}"><Style.Triggers><DataTrigger Binding="{Binding MatchLimit}" Value="40"><Setter Property="Background" Value="#29292E" /><Setter Property="Foreground" Value="#F1F1F3" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                            </Button>
                                            <Border Width="1" Background="#24242A" Margin="6,4,6,4" />
                                            <TextBlock Text="Period" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <Button Content="Act" Command="{Binding SetPerformanceScopeCommand}" CommandParameter="Act">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FilterButton}"><Style.Triggers><DataTrigger Binding="{Binding PerformanceScope}" Value="Act"><Setter Property="Background" Value="#29292E" /><Setter Property="Foreground" Value="#F1F1F3" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                            </Button>
                                            <Button Content="All" Command="{Binding SetPerformanceScopeCommand}" CommandParameter="All" Margin="0,0,4,0">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FilterButton}"><Style.Triggers><DataTrigger Binding="{Binding PerformanceScope}" Value="All"><Setter Property="Background" Value="#29292E" /><Setter Property="Foreground" Value="#F1F1F3" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                            </Button>
                                            <Border Width="1" Background="#24242A" Margin="6,4,6,4" />
                                            <TextBlock Text="Chart" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <Button Content="RR Change" Command="{Binding SetChartModeCommand}" CommandParameter="RR change">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FilterButton}"><Style.Triggers><DataTrigger Binding="{Binding ChartMode}" Value="RR change"><Setter Property="Background" Value="#29292E" /><Setter Property="Foreground" Value="#F1F1F3" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                            </Button>
                                            <Button Content="Rank Journey" Command="{Binding SetChartModeCommand}" CommandParameter="Rank journey">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FilterButton}"><Style.Triggers><DataTrigger Binding="{Binding ChartMode}" Value="Rank journey"><Setter Property="Background" Value="#29292E" /><Setter Property="Foreground" Value="#F1F1F3" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <Border MinHeight="150" BorderBrush="#27272D" BorderThickness="1" CornerRadius="10" Background="#08080A">
                                        <Grid>
                                            <ItemsControl ItemsSource="{Binding PerformanceMatches}" Margin="10">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#1D1D22" BorderThickness="0,0,0,1" Padding="8,6" Cursor="Hand">
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenMatchCommand}" />
                                                            </Border.InputBindings>
                                                            <Grid>
                                                                <TextBlock Text="{Binding Map}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Result}" Foreground="{Binding ResultColor, Converter={StaticResource HexToBrush}}"
                                                                           HorizontalAlignment="Center" FontSize="10" />
                                                                <TextBlock Text="{Binding ChartValueText}" HorizontalAlignment="Right" FontWeight="Bold"
                                                                           Foreground="{Binding ResultColor, Converter={StaticResource HexToBrush}}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <Border BorderBrush="#27272D" BorderThickness="1" CornerRadius="10" Padding="14" MinHeight="64">
                                        <TextBlock Text="{Binding PerformanceEmptyText}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                    </Border>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Border BorderBrush="#202025" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,5,0">
                                            <StackPanel>
                                                <TextBlock Text="Net RR" FontSize="8" Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding NetRrText}" FontSize="20" FontWeight="Bold" Foreground="#36D399" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" BorderBrush="#202025" BorderThickness="1" CornerRadius="10" Padding="12" Margin="5,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Record" FontSize="8" Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding RecordText}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Border BorderBrush="#202025" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,8,0,0">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding CurrentRankIcon}" Width="22" Height="22" Margin="0,0,9,0"
                                                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding CurrentRankIcon, Converter={StaticResource NullToCollapsed}}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Current rank" FontSize="8" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding CurrentRankText}" FontWeight="Bold" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CurrentRrText}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                       Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"
                                                       Visibility="{Binding CurrentRrText, Converter={StaticResource StringEmptyToCollapsed}}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            </StackPanel>

                            <!-- Match history -->
                            <StackPanel Visibility="{Binding IsMatchesTab, Converter={StaticResource BoolToVisible}}">
                                <TextBlock Text="Recent competitive matches — select any match for the full scoreboard."
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,9"
                                           Visibility="{Binding HasPerformance, Converter={StaticResource BoolToVisible}}" />
                                <Border BorderBrush="#27272D" BorderThickness="1" CornerRadius="10" Background="#08080A"
                                        Padding="18" Visibility="{Binding HasPerformance, Converter={StaticResource InvertBoolToCollapsed}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="No competitive history yet" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="Play a competitive match to begin tracking rank progress."
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0"
                                                   TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding PerformanceMatches}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#242429" BorderThickness="1" Background="#0D0D10"
                                                    CornerRadius="10" Margin="0,0,0,8" Padding="12" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenMatchCommand}" />
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="85" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="42" Height="42" CornerRadius="8" Background="#18181C" ClipToBounds="True">
                                                        <Image Source="{Binding AgentPortrait}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Map}" FontSize="14" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding Agent}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ScoreText}" FontWeight="Bold" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding DetailText}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DeltaText}" FontWeight="Bold" HorizontalAlignment="Right"
                                                                   Foreground="{Binding ResultColor, Converter={StaticResource HexToBrush}}" />
                                                        <TextBlock Text="{Binding DateText}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Sessions -->
                            <StackPanel Visibility="{Binding IsSessionsTab, Converter={StaticResource BoolToVisible}}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Content="Start new session" Command="{Binding SessionActionCommand}" CommandParameter="start" Margin="0,0,8,0" />
                                    <Button Content="Archive and restart" Style="{StaticResource SecondaryButton}" Command="{Binding SessionActionCommand}" CommandParameter="end" />
                                </StackPanel>
                                <Border BorderBrush="#27272D" BorderThickness="1" CornerRadius="10" Background="#08080A"
                                        Padding="18" Margin="0,0,0,8" Visibility="{Binding HasSessions, Converter={StaticResource InvertBoolToCollapsed}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="No sessions yet" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="Sessions track your ranked games automatically once you play."
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0"
                                                   TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding PerformanceSessions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#242429" BorderThickness="1" CornerRadius="10" Margin="0,0,0,8" Padding="14">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                        <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Matches}" Margin="0,0,20,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <TextBlock Text="{Binding Record}" Margin="0,0,20,0" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding Net}" FontWeight="Bold" Foreground="{Binding NetColor, Converter={StaticResource HexToBrush}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- Modal surface -->
        <Border Background="#D9000000" Visibility="{Binding IsPanelOpen, Converter={StaticResource BoolToVisible}}">
            <Grid>
                <Button Background="Transparent" BorderThickness="0" Padding="0"
                        Command="{Binding ClosePanelCommand}" AutomationProperties.Name="Close dialog backdrop" />
                <Border Width="620" MaxHeight="720" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#0B0B0E" BorderBrush="#303037" BorderThickness="1" CornerRadius="16"
                        Padding="24" Panel.ZIndex="1">
                    <Grid>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="36" Height="36"
                                Padding="0" Style="{StaticResource ChromeButton}" Command="{Binding ClosePanelCommand}"
                                Panel.ZIndex="100" AutomationProperties.Name="Close dialog">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" />
                        </Button>

                        <StackPanel Margin="0,0,48,0" Visibility="{Binding IsNotificationsOpen, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="Game Status" FontSize="21" FontWeight="Bold" />
                            <TextBlock Text="VALORANT CONNECTION AND BACKEND" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,7,0,22" />
                            <Border Background="#08080A" BorderBrush="#25252B" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="Everything looks good. No new notifications." Foreground="{StaticResource TextMutedBrush}"
                                               Visibility="{Binding HasNotice, Converter={StaticResource InvertBoolToCollapsed}}" />
                                    <TextBlock Text="{Binding Backend.StatusText}" Margin="0,10,0,0" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding BackendVersion}" Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>
                            <Button Content="Check for updates" Style="{StaticResource SecondaryButton}" Command="{Binding CheckUpdatesCommand}" Margin="0,14,0,0" HorizontalAlignment="Left" />
                        </StackPanel>

                        <ScrollViewer MaxHeight="650" Margin="0,0,48,0" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisible}}">
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="Settings" FontSize="21" FontWeight="Bold" />
                                <TextBlock Text="APPEARANCE, APPLICATION AND ADVANCED" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,7,0,20" />
                                <TextBlock Text="Appearance" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Accent color and dashboard background." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,10" />
                                <ItemsControl ItemsSource="{Binding AccentPresets}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="31" Height="28" Padding="0" Margin="0,0,7,0"
                                                    Background="{Binding Converter={StaticResource HexToBrush}}"
                                                    Command="{Binding DataContext.PickAccentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Apply this accent color." />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBox Text="{Binding AccentHex, UpdateSourceTrigger=PropertyChanged}" Width="105" />
                                    <Button Content="Save theme" Command="{Binding SaveAccentCommand}" Margin="0,0,8,0" />
                                    <Button Content="Reset" Style="{StaticResource DangerButton}" Command="{Binding ResetAccentCommand}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Choose background" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseBackgroundCommand}" Margin="0,0,8,0" />
                                    <Button Content="Remove" Style="{StaticResource DangerButton}" Command="{Binding RemoveBackgroundCommand}" />
                                </StackPanel>
                                <Border Height="1" Background="#242429" Margin="0,18,0,0" />
                                <TextBlock Text="Application" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,16,0,0" />
                                <TextBlock Text="Startup, updates, logs, and exit." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,10" />
                                <CheckBox x:Name="StartupCheck" Content="Start 1 Bullet with Windows"
                                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Click="StartupCheck_Click" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Check for updates" Style="{StaticResource SecondaryButton}" Command="{Binding CheckUpdatesCommand}" Margin="0,0,8,0" />
                                    <Button Content="Open logs" Style="{StaticResource UtilityButton}" Command="{Binding OpenLogsCommand}" Margin="0,0,8,0" />
                                    <Button Content="Quit 1 Bullet" Style="{StaticResource DangerButton}" Command="{Binding QuitCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding UpdateStatusText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,8,0,0" Visibility="{Binding HasUpdateStatus, Converter={StaticResource BoolToVisible}}" />
                                <Border Height="1" Background="#242429" Margin="0,18,0,0" />
                                <TextBlock Text="Gameplay automation" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,16,0,0" />
                                <TextBlock Text="Automatic agent locking during Agent Select." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,10" />
                                <Button Content="Configure instalock" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ShowPanelCommand}" CommandParameter="Instalock" HorizontalAlignment="Left" />
                                <Border Height="1" Background="#242429" Margin="0,18,0,0" />
                                <TextBlock Text="Advanced" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,16,0,0" />
                                <TextBlock Text="Only needed when troubleshooting the local backend." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,10" />
                                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap">
                                    <Run Text="App " /><Run Text="{Binding VersionText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding BackendVersion, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding RequestText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Backend.StatusText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,10" TextWrapping="Wrap" />
                                <Expander Header="Backend diagnostics" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                          Visibility="{Binding Backend.LogTail, Converter={StaticResource StringEmptyToCollapsed}}">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Backend.LogTail}" FontFamily="Consolas" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                        <Button Content="Retry connection" Style="{StaticResource SecondaryButton}" Command="{Binding RetryBackendCommand}" Margin="0,8,0,0" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Expander>
                                <Border Height="1" Background="#242429" Margin="0,18,0,0" />
                                <TextBlock Text="About" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,16,0,0" />
                                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap">
                                    <Run Text="1 Bullet " /><Run Text="{Binding VersionText, Mode=OneWay}" /><Run Text=" · Made by Saif" />
                                </TextBlock>
                                <TextBlock Text="Live VALORANT companion · UI assistance: OpenAI ChatGPT / Codex · Licensed under GPL-3.0"
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,10" TextWrapping="Wrap" />
                                <Button Content="Open repository" Style="{StaticResource UtilityButton}"
                                        Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/yksaionara/1bullet"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Margin="0,0,48,0" Visibility="{Binding IsOfflineOpen, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="Riot Presence" FontSize="21" FontWeight="Bold" />
                            <TextBlock Text="APPEAR OFFLINE, AWAY, OR ONLINE" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,7,0,20" />
                            <TextBlock Text="Choose how you appear to friends. Starting offline mode can launch the Riot client through the local presence relay."
                                       TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                            <UniformGrid Columns="2" Margin="0,18,0,0">
                                <Button Content="Offline" Command="{Binding SetOfflineStatusCommand}" CommandParameter="offline" Margin="0,0,5,8" />
                                <Button Content="Away" Style="{StaticResource SecondaryButton}" Command="{Binding SetOfflineStatusCommand}" CommandParameter="away" Margin="5,0,0,8" />
                                <Button Content="Mobile" Style="{StaticResource SecondaryButton}" Command="{Binding SetOfflineStatusCommand}" CommandParameter="mobile" Margin="0,0,5,0" />
                                <Button Content="Back online" Style="{StaticResource SecondaryButton}" Command="{Binding SetOfflineStatusCommand}" CommandParameter="online" Margin="5,0,0,0" />
                            </UniformGrid>
                            <TextBlock Text="{Binding ControlMessage}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
                        </StackPanel>

                        <StackPanel Margin="0,0,48,0" Visibility="{Binding IsInstalockOpen, Converter={StaticResource BoolToVisible}}">
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Width="34" Height="34" Padding="0"
                                        Command="{Binding ClosePanelCommand}" ToolTip="Close instalock">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" />
                                </Button>
                                <TextBlock Text="Instalock" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Background="#0A0A0D" BorderBrush="#242429" BorderThickness="1" CornerRadius="14" Padding="16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <TextBlock Text="Instalock" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="REGION" FontSize="9" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Border Background="#111116" BorderBrush="#303038" BorderThickness="1" CornerRadius="6" Padding="11,6">
                                                <TextBlock Text="AUTO" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Button Content="CHECK SIDE" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" Command="{Binding CheckSideCommand}" />
                                        <Button Grid.Column="1" Content="DODGE" Style="{StaticResource SecondaryButton}" Margin="5,0,0,0" Command="{Binding DodgeCommand}" />
                                    </Grid>
                                    <TextBlock Text="SELECT AGENT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                                    <ScrollViewer Height="292" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Agents}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource AgentTileButton}"
                                                            Command="{Binding DataContext.SelectInstalockAgentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel>
                                                            <Grid Width="68" Height="68">
                                                                <Border Background="#1A1A20" CornerRadius="5" />
                                                                <Image Source="{Binding Portrait}" Stretch="UniformToFill">
                                                                    <Image.Clip><RectangleGeometry Rect="0,0,68,68" RadiusX="5" RadiusY="5" /></Image.Clip>
                                                                </Image>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"
                                                                       Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Role}" FontSize="8" Foreground="{StaticResource TextMutedBrush}"
                                                                       HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Border BorderBrush="#2A2A30" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,7,0">
                                                <TextBlock Text="DELAY (SECONDS)" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5" />
                                                <TextBox Text="{Binding InstalockDelay}" Margin="0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                                <TextBlock Text="MODE" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5" />
                                                <UniformGrid Columns="2">
                                                    <Button Content="LOCK" Command="{Binding SetInstalockModeCommand}" CommandParameter="lock">
                                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Style.Triggers><DataTrigger Binding="{Binding InstalockMode}" Value="lock"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                                    </Button>
                                                    <Button Content="HOVER" Command="{Binding SetInstalockModeCommand}" CommandParameter="select">
                                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Style.Triggers><DataTrigger Binding="{Binding InstalockMode}" Value="select"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                                    </Button>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding InstalockStatus}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <Button Content="{Binding InstalockPrimaryText}" Command="{Binding ToggleInstalockCommand}" Padding="14,11" />
                                    <TextBlock Text="Auto-locking automates the client and may violate Riot's Terms of Service."
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,12,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
